# OpenAI API Key (used for Sol-medium orchestrator and Terra domain subagents)
OPENAI_API_KEY="sk-proj-..."

# Model routing (Accepts canonical OpenAI IDs 'gpt-5.6-sol' / 'gpt-5.6-terra' or aliases 'sol-medium' / 'terra')
ORCHESTRATOR_MODEL="gpt-5.6-sol"
WORKER_MODEL="gpt-5.6-terra"

# Fallback models if Sol/Terra are unavailable on account
FALLBACK_ORCHESTRATOR_MODEL="gpt-4o"
FALLBACK_WORKER_MODEL="gpt-4o-mini"
