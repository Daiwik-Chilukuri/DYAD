{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dyad.local/schemas/corridor-analysis-response.schema.json",
  "title": "DYAD Corridor Analysis Response",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_id",
    "status",
    "generated_at",
    "coordinate_reference_system",
    "request",
    "summary",
    "agents",
    "map",
    "errors"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "analysis_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["success", "partial", "error"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "coordinate_reference_system": {
      "type": "object",
      "required": ["name", "geojson_coordinate_order"],
      "properties": {
        "name": { "const": "EPSG:4326" },
        "geojson_coordinate_order": {
          "type": "array",
          "prefixItems": [
            { "const": "longitude" },
            { "const": "latitude" }
          ],
          "items": false
        }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["corridor", "catchment_m"],
      "properties": {
        "corridor": { "$ref": "#/$defs/geojsonFeature" },
        "catchment_m": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "summary": { "type": "object" },
    "agents": {
      "type": "object",
      "required": [
        "economic_specialist",
        "demographics_specialist",
        "ecological_specialist",
        "mobility_specialist"
      ],
      "additionalProperties": { "$ref": "#/$defs/agentResult" }
    },
    "map": {
      "type": "object",
      "required": ["layers", "focus_points"],
      "properties": {
        "layers": {
          "type": "array",
          "items": { "$ref": "#/$defs/mapLayer" }
        },
        "focus_points": {
          "type": "array",
          "items": { "$ref": "#/$defs/focusPoint" }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "agent_id": { "type": ["string", "null"] },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "retryable": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "minItems": 2,
      "maxItems": 3
    },
    "geojsonFeature": {
      "type": "object",
      "required": ["type", "id", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "id": { "type": ["string", "number"] },
        "geometry": { "type": "object" },
        "properties": { "type": "object" }
      }
    },
    "featureCollection": {
      "type": "object",
      "required": ["type", "features"],
      "properties": {
        "type": { "const": "FeatureCollection" },
        "features": {
          "type": "array",
          "items": { "$ref": "#/$defs/geojsonFeature" }
        }
      }
    },
    "metric": {
      "type": "object",
      "required": ["key", "label", "value"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "value": { "type": ["number", "string", "null"] },
        "unit": { "type": "string" },
        "display_precision": { "type": "integer", "minimum": 0 }
      }
    },
    "agentResult": {
      "type": "object",
      "required": ["status", "title", "method", "metrics", "warnings"],
      "properties": {
        "status": { "enum": ["success", "error", "skipped"] },
        "title": { "type": "string" },
        "method": { "type": ["object", "string"] },
        "metrics": {
          "type": "array",
          "items": { "$ref": "#/$defs/metric" }
        },
        "breakdown": { "type": "object" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "mapLayer": {
      "type": "object",
      "required": ["id", "source_agent", "render_as", "style_token", "geojson"],
      "properties": {
        "id": { "type": "string" },
        "source_agent": { "type": "string" },
        "render_as": { "enum": ["circle", "line", "fill", "symbol"] },
        "style_token": { "type": "string" },
        "geojson": { "$ref": "#/$defs/featureCollection" }
      }
    },
    "focusPoint": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "subtitle",
        "severity",
        "feature_ref",
        "coordinate",
        "camera"
      ],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "severity": { "enum": ["info", "warning", "critical"] },
        "feature_ref": {
          "type": "object",
          "required": ["layer_id", "feature_id"],
          "properties": {
            "layer_id": { "type": "string" },
            "feature_id": { "type": ["string", "number"] }
          }
        },
        "coordinate": {
          "type": "object",
          "required": ["longitude", "latitude"],
          "properties": {
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 }
          }
        },
        "camera": {
          "type": "object",
          "required": ["zoom", "pitch", "bearing"],
          "properties": {
            "zoom": { "type": "number" },
            "pitch": { "type": "number" },
            "bearing": { "type": "number" }
          }
        }
      }
    }
  }
}
