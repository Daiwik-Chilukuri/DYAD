# ==============================================================================
# DYAD: Browser Use Cloud Agent Configuration Example
# ==============================================================================

# Your Browser Use Cloud API Key
# Get your API key at: https://cloud.browser-use.com/settings?tab=api-keys
BROWSER_USE_API_KEY=your_browser_use_api_key_here

# Cloud Agent Model:
# - "deepseek-v4-flash-vision" (DeepSeek V4.1 Flash Vision)
# - "gpt-5.6-luna" (Fast, cost-effective V4 standard)
BROWSER_USE_MODEL=deepseek-v4-flash-vision
